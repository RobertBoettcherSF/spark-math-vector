project Vectors is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("vectors.ads");
   for Executable ("vectors.ads") use "vectors";
   
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatN", "-gnato");
   end Compiler;
   
   package Proof is
      for Provers use ("CVC4", "Z3", "Alt-Ergo");
   end Proof;
end Vectors;
